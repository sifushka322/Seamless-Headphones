<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#146E61</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F0F5F0</item>
        <item name="android:navigationBarColor">#F0F5F0</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">true</item>
</style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">#80DFBC</item>
        <item name="android:windowLightStatusBar">false</item><item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
